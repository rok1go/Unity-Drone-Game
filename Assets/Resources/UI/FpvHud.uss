.game-hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    color: rgb(247, 249, 250);
    font-size: 18px;
    -unity-text-outline-width: 0.25px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}
.small { font-size: 14px; }
.muted { color: rgb(225, 230, 234); }
.round-header { position: absolute; left: 28px; right: 28px; top: 19px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.role-panel { min-width: 220px; height: 36px; padding: 0 13px; flex-direction: row; align-items: center; }
.role { font-size: 18px; -unity-font-style: bold; }
.role-icon { width: 16px; height: 20px; margin-right: 10px; }
.role-head { position: absolute; left: 5px; top: 3px; width: 7px; height: 7px; border-radius: 4px; background-color: rgb(247, 249, 250); }
.role-body { position: absolute; left: 1px; top: 12px; width: 15px; height: 7px; border-top-left-radius: 7px; border-top-right-radius: 7px; background-color: rgb(247, 249, 250); }
.alive-panel { min-width: 205px; height: 36px; padding: 0 13px; justify-content: center; }
.alive-count { font-size: 18px; -unity-text-align: middle-right; }
.alive-panel.match-stock { height: 56px; }
.stock-count { display: none; -unity-text-align: middle-right; color: rgb(216, 230, 231); }
.clock-group { position: absolute; left: 32%; right: 32%; top: 0; flex-direction: row; align-items: center; }
.clock-rule { flex-grow: 1; height: 1px; margin-left: 14px; margin-right: 14px; background-color: rgba(238, 244, 249, 0.65); }
.round-clock { width: 168px; flex-shrink: 0; align-items: center; padding: 12px 10px 8px; }
.round-time { font-size: 32px; -unity-font-style: bold; }
.round-phase { font-size: 14px; color: rgb(246, 248, 250); }
.human-health { position: absolute; left: 40px; bottom: 30px; width: 256px; }
.health-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.health-main { justify-content: flex-start; }
.health-plus { width: 24px; height: 26px; margin-right: 14px; }
.plus-horizontal { position: absolute; left: 1px; top: 12px; width: 21px; height: 3px; background-color: rgb(244, 249, 247); }
.plus-vertical { position: absolute; left: 10px; top: 3px; width: 3px; height: 21px; background-color: rgb(244, 249, 247); }
.health-value { font-size: 28px; -unity-font-style: bold; }
.health-title { margin-bottom: 4px; display: none; }
.health-track { height: 7px; margin-top: 3px; background-color: rgba(22, 31, 32, 0.5); overflow: hidden; }
.health-fill { height: 100%; width: 100%; background-color: rgb(244, 249, 247); }
.health-hit { font-size: 15px; color: rgb(255, 162, 142); }
.crosshair { position: absolute; left: 50%; top: 50%; width: 0; height: 0; display: none; }
.crosshair-left { position: absolute; left: -22px; top: -1px; width: 13px; height: 2px; background-color: rgb(244, 249, 247); }
.crosshair-right { position: absolute; left: 9px; top: -1px; width: 13px; height: 2px; background-color: rgb(244, 249, 247); }
.crosshair-top { position: absolute; left: -1px; top: -22px; width: 2px; height: 13px; background-color: rgb(244, 249, 247); }
.crosshair-bottom { position: absolute; left: -1px; top: 9px; width: 2px; height: 13px; background-color: rgb(244, 249, 247); }
.hint-wrap { position: absolute; left: 20%; right: 20%; bottom: 24px; align-items: center; }
.hint-panel { max-width: 100%; flex-direction: row; align-items: center; padding: 7px 14px; }
.keycap { width: 24px; height: 26px; margin-right: 10px; border-width: 1px; border-color: rgba(241, 247, 248, 0.8); border-radius: 3px; font-size: 17px; -unity-text-align: middle-center; }
.hint { flex-shrink: 1; font-size: 17px; white-space: normal; -unity-text-align: middle-center; }
.help { position: absolute; right: 28px; bottom: 90px; width: 310px; padding: 16px 18px; background-color: rgba(15, 25, 31, 0.85); border-radius: 8px; white-space: normal; font-size: 16px; display: none; }
.warning-wrap { position: absolute; left: 20%; right: 20%; bottom: 84px; align-items: center; }
.warning-panel { max-width: 100%; padding: 9px 38px; display: none; }
.warning { color: rgb(247, 249, 250); font-size: 18px; white-space: normal; -unity-text-align: middle-center; }
.damage-flash { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-width: 8px; border-color: rgba(188, 45, 37, 0.7); opacity: 0; }
.result-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8, 9, 10, 0.72); align-items: center; justify-content: center; display: none; }
.result-panel { width: 400px; align-items: stretch; }
.result-title { font-size: 34px; -unity-text-align: middle-center; white-space: normal; }
.result-reason { margin-top: 12px; margin-bottom: 30px; color: rgb(218, 222, 224); font-size: 16px; white-space: normal; -unity-text-align: middle-center; }
.restart-button { height: 44px; margin: 0 65px; background-color: rgb(229, 227, 217); color: rgb(24, 25, 25); border-width: 0; border-radius: 2px; font-size: 16px; -unity-text-outline-width: 0; }
.restart-button:hover { background-color: rgb(250, 248, 238); }
.restart-button:active { background-color: rgb(194, 192, 183); }
.result-key { margin-top: 12px; -unity-text-align: middle-center; }
.drone-osd { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-size: 22px; letter-spacing: 1px; -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgba(0, 0, 0, 0.45); display: none; }
.flight-geometry { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.osd-identity { position: absolute; left: 3%; top: 8%; font-size: 21px; letter-spacing: 3px; }
.osd-clock { position: absolute; left: 3%; top: 12%; font-size: 22px; }
.osd-state { position: absolute; right: 3%; top: 9%; font-size: 20px; }
.osd-heading { position: absolute; left: 44%; right: 44%; top: 19%; font-size: 22px; -unity-text-align: middle-center; }
.osd-speed { position: absolute; left: 5.1%; width: 6.3%; top: 46%; margin-top: -18px; height: 36px; font-size: 26px; -unity-text-align: middle-center; }
.osd-altitude { position: absolute; left: 89.2%; right: 4.1%; top: 46%; margin-top: -18px; height: 36px; font-size: 26px; -unity-text-align: middle-center; }
.osd-speed-unit { position: absolute; left: 6%; width: 10%; top: 64%; font-size: 21px; -unity-text-align: middle-center; }
.osd-altitude-unit { position: absolute; left: 86%; right: 4%; top: 64%; font-size: 21px; -unity-text-align: middle-center; }
.osd-home { position: absolute; left: 35%; right: 35%; top: 74%; font-size: 23px; -unity-text-align: middle-center; }
.osd-power { position: absolute; left: 3%; bottom: 10%; }
.osd-movement { position: absolute; left: 25%; bottom: 10%; }
.osd-coordinates { position: absolute; left: 55%; bottom: 10%; }
.osd-attitude { position: absolute; right: 3%; bottom: 10%; }
.osd-power > Label, .osd-movement > Label, .osd-coordinates > Label, .osd-attitude > Label { margin-bottom: 8px; }

.osd {
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    color: rgb(223, 255, 237);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0.25px;
    -unity-text-outline-color: rgba(4, 16, 22, 0.85);
}
.top-bar { position: absolute; top: 32px; left: 38px; right: 38px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.identity { border-left-width: 3px; border-left-color: rgb(118, 250, 182); padding-left: 14px; width: 310px; }
.brand { font-size: 26px; letter-spacing: 2px; }
.eyebrow { font-size: 14px; letter-spacing: 1px; color: rgb(192, 235, 211); margin-top: 5px; }
.compass { align-items: center; width: 200px; }
.compass-ticks { color: rgb(118, 250, 182); font-size: 24px; letter-spacing: 6px; }
.heading { font-size: 21px; letter-spacing: 3px; }
.flight-status { align-items: flex-end; width: 310px; }
.mode { background-color: rgba(8, 25, 29, 0.82); color: rgb(118, 250, 182); border-width: 1px; border-color: rgba(118, 250, 182, 0.4); padding: 7px 12px; font-size: 13px; letter-spacing: 1px; }
.timer { font-size: 30px; letter-spacing: 4px; margin-top: 8px; }
.aim-area { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.horizon { position: absolute; left: -110px; top: 0; width: 220px; height: 1px; transform-origin: 50% 50%; }
.horizon-left { position: absolute; left: 0; top: 0; width: 80px; height: 2px; background-color: rgba(118, 250, 182, 0.8); }
.horizon-right { position: absolute; right: 0; top: 0; width: 80px; height: 2px; background-color: rgba(118, 250, 182, 0.8); }
.horizon-notch { position: absolute; left: 109px; top: -5px; width: 2px; height: 10px; background-color: rgba(118, 250, 182, 0.8); }
.reticle-left { position: absolute; left: -22px; top: -1px; width: 12px; height: 3px; background-color: rgb(245, 255, 247); }
.reticle-right { position: absolute; left: 10px; top: -1px; width: 12px; height: 3px; background-color: rgb(245, 255, 247); }
.reticle-dot { position: absolute; left: -2px; top: -2px; width: 4px; height: 4px; background-color: rgb(245, 255, 247); }
.attitude { position: absolute; top: 139px; left: -120px; width: 240px; padding: 4px; -unity-text-align: middle-center; color: rgb(207, 243, 224); background-color: rgba(7, 20, 27, 0.55); font-size: 13px; letter-spacing: 2px; }
.telemetry-left { position: absolute; left: 38px; top: 36%; width: 210px; padding: 16px; border-left-width: 2px; border-left-color: rgba(118, 250, 182, 0.65); background-color: rgba(7, 20, 27, 0.8); }
.reading-row { flex-direction: row; align-items: flex-end; }
.big-reading { font-size: 58px; letter-spacing: 1px; }
.unit { font-size: 14px; margin-left: 8px; color: rgb(155, 196, 184); }
.divider { height: 1px; background-color: rgba(155, 196, 184, 0.25); margin-top: 4px; margin-bottom: 12px; }
.altitude { font-size: 34px; }
.climb { font-size: 14px; color: rgb(155, 196, 184); margin-top: 3px; }
.telemetry-right { position: absolute; right: 42px; top: 34%; align-items: center; width: 90px; }
.throttle-track { width: 14px; height: 180px; margin-top: 12px; margin-bottom: 8px; background-color: rgba(7, 20, 27, 0.75); border-width: 1px; border-color: rgba(155, 196, 184, 0.45); }
.throttle-fill { position: absolute; left: 2px; right: 2px; bottom: 2px; height: 42%; background-color: rgb(118, 250, 182); }
.hover-mark { position: absolute; left: -6px; right: -6px; bottom: 42%; height: 1px; background-color: rgb(255, 211, 130); }
.throttle-reading { font-size: 24px; }
.throttle-keys { font-size: 13px; color: rgb(207, 243, 224); background-color: rgba(7, 20, 27, 0.65); padding: 4px 6px; white-space: normal; -unity-text-align: middle-center; margin-top: 10px; }
.warning-wrap { position: absolute; bottom: 200px; left: 15%; right: 15%; align-items: center; }
.warning { color: rgb(255, 211, 130); background-color: rgba(38, 24, 12, 0.88); border-width: 1px; border-color: rgba(255, 184, 91, 0.6); padding: 10px 20px; font-size: 16px; letter-spacing: 1px; }
.bottom-bar { position: absolute; left: 38px; right: 38px; bottom: 28px; }
.bottom-heading { flex-direction: row; justify-content: space-between; margin-bottom: 6px; padding: 6px 12px; background-color: rgba(7, 20, 27, 0.65); }
.home { font-size: 15px; letter-spacing: 2px; }
.muted { color: rgb(192, 235, 211); font-size: 14px; }
.help { background-color: rgba(7, 20, 27, 0.85); border-top-width: 1px; border-top-color: rgba(118, 250, 182, 0.35); padding: 12px 16px; font-size: 15px; }
.help > Label { margin-bottom: 4px; white-space: normal; }
.help-note { color: rgb(192, 235, 211); font-size: 13px; }
.pilot-hint { position: absolute; left: 28px; bottom: 24px; padding: 12px 18px; background-color: rgba(7, 20, 27, 0.8); border-left-width: 2px; border-left-color: rgb(118, 250, 182); color: rgb(223, 255, 237); font-size: 14px; }
.hint-brand { font-size: 10px; color: rgb(118, 250, 182); letter-spacing: 2px; margin-bottom: 5px; }

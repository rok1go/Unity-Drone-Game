.prototype-menu { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; justify-content: center; align-items: center; color: rgb(239, 244, 244); font-size: 17px; }
.menu-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.menu-card { width: 480px; max-height: 94%; padding: 24px; }
.menu-wide { width: 1080px; max-width: 94%; max-height: 96%; padding: 24px; }
.menu-title { font-size: 40px; -unity-font-style: bold; margin-bottom: 8px; white-space: normal; }
.menu-subtitle { color: rgb(179, 194, 201); font-size: 17px; margin-bottom: 26px; white-space: normal; }
.menu-button { height: 44px; margin: 6px 0; padding: 0 20px; border-width: 1px; border-color: rgba(209, 226, 234, 0.24); border-radius: 7px; background-color: rgba(53, 76, 88, 0.38); color: rgb(238, 243, 245); font-size: 17px; -unity-text-align: middle-center; }
.menu-button:hover { background-color: rgba(91, 118, 130, 0.6); border-color: rgba(224, 237, 240, 0.55); }
.menu-button:active { background-color: rgba(38, 58, 70, 0.9); }
.menu-button.primary { background-color: rgb(214, 231, 226); color: rgb(17, 35, 40); border-width: 0; }
.menu-button.primary:hover { background-color: rgb(240, 249, 245); }
.menu-button:disabled { opacity: 0.45; }
.menu-status { color: rgb(197, 219, 224); margin-top: 8px; white-space: normal; }
.menu-error { color: rgb(255, 169, 151); margin-top: 8px; white-space: normal; font-size: 15px; }
.section-title { font-size: 20px; -unity-font-style: bold; margin-bottom: 14px; }
.code-row { flex-direction: row; align-items: center; margin-bottom: 24px; }
.lobby-code { font-size: 27px; letter-spacing: 3px; margin-right: 24px; }
.code-row .menu-button { height: 36px; font-size: 14px; }
.lobby-columns { flex-direction: row; margin-bottom: 20px; }
.players-column { flex-grow: 1; flex-basis: 60%; padding-right: 32px; }
.settings-column { flex-grow: 1; flex-basis: 40%; padding-left: 25px; border-left-width: 1px; border-left-color: rgba(209, 226, 234, 0.18); }
.player-row { flex-direction: row; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(209, 226, 234, 0.12); }
.player-name { flex-grow: 1; flex-shrink: 1; white-space: normal; }
.player-team { width: 90px; font-size: 15px; color: rgb(201, 216, 222); }
.player-ready { width: 80px; font-size: 15px; color: rgb(175, 224, 191); }
.player-waiting { width: 80px; font-size: 15px; color: rgb(169, 180, 186); }
.inline-buttons { flex-direction: row; margin-top: 16px; }
.inline-buttons .menu-button { flex-grow: 1; margin-right: 8px; font-size: 15px; }
.field-note { color: rgb(159, 181, 190); font-size: 14px; margin-top: 10px; margin-bottom: 10px; white-space: normal; }
.settings-summary { font-size: 17px; white-space: normal; }
.unity-base-field { margin: 5px 0 10px; min-height: 35px; font-size: 16px; }
.unity-base-field__label { min-width: 175px; color: rgb(206, 219, 225); padding-top: 6px; }
.unity-base-field__input { background-color: rgba(14, 27, 35, 0.8); border-width: 1px; border-color: rgba(191, 215, 226, 0.3); border-radius: 5px; color: rgb(245, 249, 250); padding: 5px 9px; }
.unity-base-text-field__input:focus { border-color: rgb(205, 232, 225); }
.code-input .unity-base-field__input { font-size: 24px; letter-spacing: 4px; }
